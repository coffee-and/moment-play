{
  "name": "moment-play",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.23 <23",
    "npm": ">=10.9 <11"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check:static": "eslint . --max-warnings 0",
    "check:css-tokens": "node scripts/check-css-custom-properties.mjs",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "quality": "npm run check:static && npm run lint:styles && npm run check:css-tokens",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:db": "supabase test db",
    "test:db:ranking": "supabase test db supabase/tests/phase3_game_results_test.sql",
    "test:db:friends": "supabase test db supabase/tests/phase4_friendships_test.sql",
    "test:db:invites": "supabase test db supabase/tests/phase5_friend_omok_invites_test.sql supabase/tests/phase5_omok_nickname_sync_test.sql",
    "test:db:auth": "supabase test db supabase/tests/prelaunch_auth_foundation_test.sql"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "stylelint": "^17.14.1",
    "supabase": "2.114.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
